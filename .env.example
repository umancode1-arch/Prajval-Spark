# Supabase (get from supabase.com project settings > API)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (get from razorpay.com dashboard > API keys)
RAZORPAY_KEY_ID=your-key-id
RAZORPAY_KEY_SECRET=your-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-key-id

# Local testing only: this bypasses payment verification and grants premium access.
NEXT_PUBLIC_PREMIUM_DEMO_ACCESS_ENABLED=false
